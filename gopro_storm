#!/usr/bin/env ruby
# GoPro File Import and Organization Script
# This script imports GoPro files from an SD card and organizes them by week and year

require 'fileutils'
require 'date'
require 'digest'
require 'mini_exiftool'
require 'optparse'

DEFAULT_DESTINATION_PATH = "/Users/#{ENV['USER']}/Gopro"

# A small btop-inspired terminal UI: rounded panels with bracketed titles,
# aligned key/value rows, and a smooth gradient progress bar that redraws in
# place. Falls back to plain, color-free output when stdout is not a TTY.
class UI
  RESET = "\e[0m"
  BOLD  = "\e[1m"
  ANSI  = /\e\[[0-9;]*m/
  # Eighth-block characters for sub-cell bar resolution (btop-style smoothness)
  BLOCKS = [' ', '▏', '▎', '▍', '▌', '▋', '▊', '▉', '█'].freeze
  SYMBOLS = { ok: '✔', warn: '⚠', err: '✘', info: '•', go: '⟳' }.freeze

  def initialize(io = $stdout)
    @io = io
    @rich = io.respond_to?(:tty?) && io.tty? && ENV['NO_COLOR'].to_s.empty?
    # Prefer 24-bit true-color when the terminal advertises it (smoother
    # gradients); otherwise fall back to the widely-supported 256-color cube.
    @truecolor = @rich && ENV['COLORTERM'].to_s.match?(/(truecolor|24bit)/i)
    @gradient = [[0x29, 0x9b, 0xff], [0x2d, 0xd5, 0x96], [0xa6, 0xff, 0x96]]
    @p_lines = 0
  end

  def rich?
    @rich
  end

  def width
    @width ||= begin
      cols = nil
      begin
        require 'io/console'
        cols = IO.console && IO.console.winsize.last
      rescue StandardError
        cols = nil
      end
      cols = ENV['COLUMNS'].to_i if (cols.nil? || cols.zero?) && ENV['COLUMNS'].to_i.positive?
      cols = 88 if cols.nil? || cols.zero?
      [[cols, 100].min, 46].max
    end
  end

  def content_width
    width - 4
  end

  # Emit a foreground color escape: 24-bit true-color when supported, else the
  # xterm 256-color cube (broad support, e.g. macOS Terminal.app lacks 24-bit).
  def color(r, g, b)
    return '' unless @rich
    return "\e[38;2;#{r};#{g};#{b}m" if @truecolor

    idx = 16 + (36 * quant(r)) + (6 * quant(g)) + quant(b)
    "\e[38;5;#{idx}m"
  end

  def reset; @rich ? RESET : ''; end
  def bold;  @rich ? BOLD : ''; end

  # Theme palette
  def c_border = color(0x3a, 0x47, 0x73)
  def c_title  = color(0x7b, 0xd6, 0xff)
  def c_label  = color(0x96, 0x9e, 0xb4)
  def c_value  = color(0xe4, 0xe6, 0xec)
  def c_dim    = color(0x58, 0x5e, 0x70)
  def c_ok     = color(0x78, 0xe3, 0x8c)
  def c_warn   = color(0xff, 0xd1, 0x66)
  def c_err    = color(0xff, 0x5c, 0x6c)

  def visible(str)
    str.gsub(ANSI, '').length
  end

  def clip(text, max)
    text = text.to_s
    return text if text.length <= max
    return text[0, [max, 0].max].to_s if max <= 1

    "…#{text[-(max - 1), max - 1]}"
  end

  # Draw a rounded panel. `lines` are pre-built (optionally colored) strings.
  def box(title, lines)
    unless @rich
      @io.puts
      @io.puts(title.to_s.upcase) if title
      lines.each { |line| @io.puts "  #{line.gsub(ANSI, '')}" }
      return
    end

    @io.puts top_border(title)
    lines.each { |line| @io.puts row(line) }
    @io.puts bottom_border
  end

  def top_border(title)
    return "#{c_border}╭#{'─' * (width - 2)}╮#{reset}" unless title

    label = clip(title, width - 9)
    fill = [width - 7 - label.length, 0].max
    "#{c_border}╭─┤#{reset}#{c_title}#{bold} #{label} #{reset}#{c_border}├#{'─' * fill}╮#{reset}"
  end

  def bottom_border
    "#{c_border}╰#{'─' * (width - 2)}╯#{reset}"
  end

  def row(content)
    pad = [content_width - visible(content), 0].max
    "#{c_border}│#{reset} #{content}#{' ' * pad} #{c_border}│#{reset}"
  end

  # Build an aligned "label   value" row string for use inside a box.
  def kv(label, value, label_width)
    lbl = label.to_s.ljust(label_width)
    avail = [content_width - label_width - 1, 0].max
    "#{c_label}#{lbl}#{reset} #{c_value}#{clip(value, avail)}#{reset}"
  end

  def item(kind, text)
    @io.puts "#{kind_color(kind)}#{SYMBOLS[kind]}#{reset} #{text}"
  end

  def note(text)
    @io.puts "#{c_dim}#{text}#{reset}"
  end

  def blank
    @io.puts
  end

  def colorize(kind, text)
    "#{kind_color(kind)}#{text}#{reset}"
  end

  # Render a gradient bar `length` cells wide for `fraction` in 0..1.
  def bar(fraction, length)
    fraction = 0.0 if fraction.negative?
    fraction = 1.0 if fraction > 1
    return ('#' * (fraction * length).round).ljust(length, '.') unless @rich

    eighths = (fraction * length * 8).round
    full = eighths / 8
    rem = eighths % 8
    out = +''
    length.times do |i|
      if i < full
        out << gradient(i, length) << '█'
      elsif i == full && rem.positive?
        out << gradient(i, length) << BLOCKS[rem]
      else
        out << c_dim << '░'
      end
    end
    out << reset
  end

  # --- live progress panel ---

  def progress_start(total, title)
    @p_total = total
    @p_title = title
    @p_lines = 0
    @io.puts "Processing #{total} file(s)..." unless @rich
  end

  def progress(done, file, dir, action)
    unless @rich
      @io.puts "[#{done}/#{@p_total}] #{action}: #{file}"
      return
    end

    lines = progress_lines(done, file, dir, action)
    @io.print "\e[#{@p_lines}A" if @p_lines.positive?
    lines.each { |line| @io.print "\r\e[2K#{line}\n" }
    @p_lines = lines.length
    @io.flush
  end

  def progress_finish
    @io.puts if @rich
  end

  private

  def quant(component)
    (component * 5 / 255.0).round
  end

  def kind_color(kind)
    { ok: c_ok, warn: c_warn, err: c_err, info: c_label, go: c_title }[kind] || ''
  end

  def gradient(index, length)
    return '' unless @rich

    t = length <= 1 ? 0.0 : index.to_f / (length - 1)
    seg = t * (@gradient.length - 1)
    i = [seg.floor, @gradient.length - 2].min
    f = seg - i
    a = @gradient[i]
    b = @gradient[i + 1]
    color(*[0, 1, 2].map { |k| (a[k] + ((b[k] - a[k]) * f)).round })
  end

  def progress_lines(done, file, dir, action)
    fraction = @p_total.positive? ? done.to_f / @p_total : 1.0
    pct = (fraction * 100).round
    suffix = "#{pct.to_s.rjust(3)}%  #{c_dim}#{done}/#{@p_total}#{reset}"
    label_width = 5
    bar_len = [content_width - visible(suffix) - 2, 10].max
    [
      top_border(@p_title),
      row(kv('file', "#{action}  #{file}", label_width)),
      row(kv('dir', dir || '—', label_width)),
      row("#{bar(fraction, bar_len)}  #{c_value}#{suffix}"),
      bottom_border
    ]
  end
end

class GoProImporter
  GOPRO_EXTENSIONS = ['.mp4', '.mov', '.jpg', '.jpeg', '.raw', '.gpr']

  # Common volume mount points to check for GoPro data
  COMMON_VOLUMES = [
    '/Volumes',      # macOS
    '/media',        # Linux
    '/mnt',          # Linux alternative
  ]

  def initialize(source_paths, destination_path = Dir.pwd, dry_run = false, max_files = nil, since_date = nil, until_date = nil, check = false, clean = false, delete_after = false)
    @source_paths = Array(source_paths) # Ensure it's always an array
    @destination_path = destination_path
    @dry_run = dry_run
    @max_files = max_files
    @since_date = since_date
    @until_date = until_date
    @check = check
    @clean = clean
    @delete_after = delete_after
    @processed_files = 0
    @skipped_files = 0
    @duplicate_skipped = 0
    @deleted_sources = 0
    @errors = []
    @checksum_cache = {}
    @ui = UI.new
  end

  def run
    print_header

    validate_paths

    if @check
      run_check
    elsif @clean
      run_clean
    else
      process_files
      print_summary
    end
  end

  def print_header
    lw = 12
    rows = [
      @ui.kv('Sources', @source_paths.join(', '), lw),
      @ui.kv('Destination', @destination_path, lw),
      @ui.kv('Mode', mode_label, lw)
    ]
    rows << @ui.kv('Since', @since_date.to_s, lw) if @since_date
    rows << @ui.kv('Until', @until_date.to_s, lw) if @until_date
    @ui.box('gopro storm', rows)
  end

  def mode_label
    if @check
      'CHECK (compare SHA-256, no files changed)'
    elsif @clean
      @dry_run ? 'CLEAN (dry run, no files deleted)' : 'CLEAN (delete verified copies from source)'
    elsif @delete_after
      @dry_run ? 'MOVE (dry run, nothing copied or deleted)' : 'MOVE (copy, then delete verified source files)'
    else
      @dry_run ? 'DRY RUN (no files will be copied)' : 'LIVE RUN'
    end
  end

  private

  def validate_paths
    @source_paths.each do |source_path|
      unless Dir.exist?(source_path)
        raise "Source path does not exist: #{source_path}"
      end
    end

    if @check || @clean
      # In check/clean modes we compare against existing copies, so the
      # destination must already exist — never create it.
      unless Dir.exist?(@destination_path)
        raise "Destination path does not exist: #{@destination_path}"
      end
    elsif !Dir.exist?(@destination_path)
      @ui.note("Creating destination directory: #{@destination_path}")
      FileUtils.mkdir_p(@destination_path)
      @ui.item(:ok, 'Destination directory created.')
    end
  end

  def process_files
    @ui.note('Scanning for GoPro files…')

    gopro_files = find_gopro_files

    # Limit files in dry-run mode if max_files is specified
    if @dry_run && @max_files && gopro_files.length > @max_files
      @ui.item(:info, "Found #{gopro_files.length} GoPro files (limiting to #{@max_files} for dry-run)")
      gopro_files = gopro_files.first(@max_files)
    else
      @ui.item(:info, "Found #{gopro_files.length} GoPro files")
    end
    @ui.blank

    title = @delete_after ? 'Moving' : 'Importing'
    @ui.progress_start(gopro_files.length, title)

    done = 0
    gopro_files.each do |file_path|
      process_file(file_path)
      done += 1
      @ui.progress(done, @current_file, @current_dir, @current_action)
    end

    @ui.progress_finish
  end

  # Detect volumes that contain GoPro data
  def self.detect_gopro_volumes
    detected_volumes = []

    COMMON_VOLUMES.each do |base_path|
      next unless Dir.exist?(base_path)

      begin
        Dir.glob("#{base_path}/*").each do |volume_path|
          next unless Dir.exist?(volume_path)
          next if volume_path.end_with?('/.Trashes') # Skip macOS trash
          next if volume_path == '/Volumes/Macintosh HD' # Always skip system drive

          begin
            if contains_gopro_data?(volume_path)
              detected_volumes << volume_path
            end
          rescue
            # Skip volumes we can't access
            next
          end
        end
      rescue
        # Skip base paths we can't access
        next
      end
    end

    detected_volumes
  end

  # Check if a volume contains GoPro data
  def self.contains_gopro_data?(volume_path)
    # Check for common GoPro directory structures
    gopro_indicators = [
      "#{volume_path}/DCIM/100GOPRO",
      "#{volume_path}/DCIM/101GOPRO",
      "#{volume_path}/DCIM/102GOPRO",
      "#{volume_path}/MISC"
    ]

    gopro_indicators.each do |indicator_path|
      return true if Dir.exist?(indicator_path)
    end

    # Check for GoPro files in the root or DCIM directory
    ['.', 'DCIM'].each do |subdir|
      check_path = subdir == '.' ? volume_path : "#{volume_path}/#{subdir}"
      next unless Dir.exist?(check_path)

      begin
        Dir.glob("#{check_path}/**/*").each do |file|
          next unless File.file?(file)
          filename = File.basename(file)
          return true if filename =~ /GOPR\d{4}\./i || filename =~ /GP\d{2}\d{4}\./i
        end
      rescue
        # Skip directories we can't access
        next
      end
    end

    false
  end

  def find_gopro_files
    files = []

    @source_paths.each do |source_path|
      # Search recursively in each source path
      # This avoids duplicate searches in overlapping directories
      Dir.glob(File.join(source_path, '**', '*')).each do |file|
        next unless File.file?(file)
        next unless gopro_file?(file)

        files << file
      end
    end

    files.uniq # Remove any potential duplicates
  end

  def gopro_file?(file_path)
    extension = File.extname(file_path).downcase
    GOPRO_EXTENSIONS.include?(extension) ||
    file_path =~ /GOPR\d{4}\./i ||  # GOPR0001.MP4 pattern
    file_path =~ /GP\d{2}\d{4}\./i || # GP011234.MP4 pattern
    file_path =~ /GX\d{2}\d{4}\./i || # GX011234.MP4 pattern
    file_path =~ /GH\d{2}\d{4}\./i    # GH011234.MP4 pattern
  end

  def process_file(file_path)
    @current_file = File.basename(file_path)
    @current_dir = nil
    @current_action = 'scan'

    begin
      # Fast pre-filter using mtime to avoid expensive EXIF reads.
      # mtime is typically >= creation date, so if mtime is too old
      # the file can be safely skipped.
      file_mtime = File.mtime(file_path).to_date
      if @since_date && file_mtime < @since_date
        @skipped_files += 1
        @current_action = 'skip·date'
        return
      end
      # For --until, skip if mtime is after the cutoff. Since mtime >= creation date,
      # we can't safely pre-filter here — the EXIF date might still be in range.

      metadata = extract_metadata(file_path)
      creation_date = determine_creation_date(metadata, file_path)

      return unless creation_date

      if @since_date && creation_date < @since_date
        @skipped_files += 1
        @current_action = 'skip·date'
        return
      end

      if @until_date && creation_date > @until_date
        @skipped_files += 1
        @current_action = 'skip·date'
        return
      end

      week_dir = create_week_directory(creation_date)
      @current_dir = week_dir
      status = copy_file_to_directory(file_path, week_dir)

      if status == :copied
        @processed_files += 1
        @current_action = @delete_after ? 'move' : 'copy'
      else
        @current_action = 'skip·dup'
      end
    rescue => e
      @errors << "#{file_path}: #{e.message}"
      @current_action = 'error'
    end
  end

  def extract_metadata(file_path)
    begin
      exif = MiniExiftool.new(file_path)
      return exif if exif && exif.errors.empty?
    rescue => e
      # Silently handle metadata extraction errors
    end

    nil
  end

  def determine_creation_date(metadata, file_path)
    # If we have metadata, try to extract date from it
    if metadata
      # Try various date fields that GoPro files might have
      date_fields = [
        :date_time_original,
        :create_date,
        :date_time,
        :modify_date,
        :file_modify_date
      ]

      date_fields.each do |field|
        date_value = metadata[field]
        next unless date_value

        begin
          # Handle different date formats
          if date_value.is_a?(String)
            # Parse string dates
            parsed_date = DateTime.parse(date_value)
            return parsed_date.to_date
          elsif date_value.is_a?(DateTime) || date_value.is_a?(Date)
            return date_value.to_date
          end
        rescue => e
          # Silently skip unparseable dates during processing
          next
        end
      end
    end

    # Fallback to file modification time
    # Note: Warnings are suppressed during progress bar display to keep output clean
    File.mtime(file_path).to_date
  rescue => e
    puts "Error determining creation date for #{File.basename(file_path)}: #{e.message}"
    nil
  end

  def create_week_directory(date)
    year = date.year
    week = date.cweek.to_s.rjust(2, '0')  # Zero-pad week number

    dir_name = "#{year}_week_#{week}"
    dir_path = File.join(@destination_path, dir_name)

    unless @dry_run
      FileUtils.mkdir_p(dir_path) unless Dir.exist?(dir_path)
    end

    dir_path
  end

  def copy_file_to_directory(source_file, destination_dir)
    filename = File.basename(source_file)
    destination_file = File.join(destination_dir, filename)
    base_name = File.basename(filename, '.*')
    extension = File.extname(filename)

    # If a same-named file already exists and is byte-for-byte identical
    # (verified by checksum), there's nothing to copy — skip it. With --move the
    # source file is removed since it's already safely stored.
    if File.exist?(destination_file) && files_identical?(source_file, destination_file)
      @duplicate_skipped += 1
      delete_source(source_file) if @delete_after
      return :skipped
    end

    # A same-named file exists but differs in content: keep both by adding a
    # numeric suffix to the new copy.
    counter = 1
    while File.exist?(destination_file)
      destination_file = File.join(destination_dir, "#{base_name}_#{counter}#{extension}")
      counter += 1
    end

    unless @dry_run
      FileUtils.cp(source_file, destination_file, preserve: true)
    end

    # Only remove the source after confirming the copy is intact.
    if @delete_after
      if @dry_run
        @deleted_sources += 1 # preview only
      elsif files_identical?(source_file, destination_file)
        delete_source(source_file)
      else
        @errors << "Copy verification failed for #{filename}; source left in place."
      end
    end

    :copied
  end

  # Compare two files cheaply (size first, then checksum) to decide if they are
  # byte-for-byte identical.
  def files_identical?(file_a, file_b)
    return false unless File.size(file_a) == File.size(file_b)

    file_checksum(file_a) == file_checksum(file_b)
  end

  # Delete a source file (respecting dry-run) and track the count.
  def delete_source(source_file)
    File.delete(source_file) unless @dry_run
    @deleted_sources += 1
  rescue => e
    @errors << "Failed to delete source #{source_file}: #{e.message}"
  end

  # --- checksum verification helpers (used by --check and --clean) ---

  # Collect source files, applying the same date filtering used for import.
  def collect_source_files
    files = find_gopro_files
    return files unless @since_date || @until_date

    files.select { |file| within_date_range?(file) }
  end

  def within_date_range?(file_path)
    creation_date = determine_creation_date(extract_metadata(file_path), file_path)
    return true unless creation_date

    return false if @since_date && creation_date < @since_date
    return false if @until_date && creation_date > @until_date

    true
  rescue
    # If we can't determine the date, include the file rather than silently dropping it.
    true
  end

  # Build a lookup of destination files keyed by their normalized base name so a
  # source file can be matched to its copy even when a numeric suffix was added
  # to avoid a filename collision (e.g. GOPR0001_1.MP4).
  def build_destination_index
    index = Hash.new { |hash, key| hash[key] = [] }

    Dir.glob(File.join(@destination_path, '**', '*')).each do |path|
      next unless File.file?(path)

      index[normalized_base(File.basename(path))] << path
    end

    index
  end

  # Strip a trailing "_<number>" duplicate suffix and lower-case for matching.
  def normalized_base(filename)
    extension = File.extname(filename)
    name = File.basename(filename, extension).sub(/_\d+\z/, '')
    "#{name}#{extension}".downcase
  end

  # SHA-256 is used rather than MD5: on modern CPUs (Apple Silicon / x86 with
  # SHA-NI) it is hardware-accelerated and ~3x faster than MD5, while also being
  # far more collision-resistant. Digest#file streams the file in chunks.
  def file_checksum(path)
    @checksum_cache[path] ||= Digest::SHA256.file(path).hexdigest
  end

  def run_check
    source_files = collect_source_files
    destination_index = build_destination_index

    @ui.note("Comparing SHA-256 of #{source_files.length} source file(s) against destination copies…")
    @ui.blank

    matched = 0
    mismatched = 0
    missing = 0

    source_files.each do |source_file|
      basename = File.basename(source_file)
      candidates = destination_index[normalized_base(basename)]

      if candidates.empty?
        missing += 1
        @ui.item(:err, "#{@ui.colorize(:err, 'missing')}  #{basename} (no copy found in destination)")
        next
      end

      source_digest = file_checksum(source_file)

      if candidates.any? { |candidate| file_checksum(candidate) == source_digest }
        matched += 1
        @ui.item(:ok, basename)
      else
        mismatched += 1
        @ui.item(:warn, "#{@ui.colorize(:warn, 'mismatch')}  #{basename} (copy exists but checksum differs)")
      end
    end

    @ui.blank
    lw = 12
    rows = [@ui.kv('Verified', matched, lw)]
    rows << @ui.kv('Mismatch', mismatched, lw) if mismatched > 0
    rows << @ui.kv('Missing', missing, lw) if missing > 0
    @ui.box('Check summary', rows)

    @ui.blank
    if mismatched.zero? && missing.zero?
      @ui.item(:ok, @ui.colorize(:ok, 'All source files have a verified copy in the destination.'))
    else
      @ui.item(:err, @ui.colorize(:err, 'Some files are missing or do not match their copy.'))
    end
  end

  def run_clean
    source_files = collect_source_files
    destination_index = build_destination_index

    @ui.note("Cleaning #{source_files.length} source file(s) with a verified copy in destination…")
    @ui.blank

    deleted = 0
    skipped = 0
    warnings = 0

    source_files.each do |source_file|
      basename = File.basename(source_file)
      candidates = destination_index[normalized_base(basename)]

      if candidates.empty?
        skipped += 1
        @ui.item(:info, "#{@ui.colorize(:info, 'skip')}  #{basename} (no file found in destination)")
        next
      end

      source_digest = file_checksum(source_file)

      if candidates.any? { |candidate| file_checksum(candidate) == source_digest }
        File.delete(source_file) unless @dry_run
        verb = @dry_run ? 'would delete' : 'deleted'
        @ui.item(:ok, "#{@ui.colorize(:ok, verb)}  #{basename} (verified copy exists)")
        deleted += 1
      else
        warnings += 1
        @ui.item(:warn, "#{@ui.colorize(:warn, 'mismatch')}  #{basename} — copy exists but differs, not deleting.")
      end
    end

    @ui.blank
    lw = 14
    rows = [@ui.kv(@dry_run ? 'Would delete' : 'Deleted', deleted, lw)]
    rows << @ui.kv('Skipped', skipped, lw) if skipped > 0
    rows << @ui.kv('Mismatch kept', warnings, lw) if warnings > 0
    rows << @ui.kv('Mode', mode_label, lw)
    @ui.box(@dry_run ? 'Clean summary · dry run' : 'Clean summary', rows)
  end

  def print_summary
    lw = 18
    rows = [@ui.kv(@dry_run ? 'Files to copy' : 'Files copied', @processed_files, lw)]
    rows << @ui.kv('Already present', @duplicate_skipped, lw) if @duplicate_skipped > 0
    rows << @ui.kv('Outside date range', @skipped_files, lw) if @skipped_files > 0
    if @delete_after
      rows << @ui.kv(@dry_run ? 'Sources to delete' : 'Sources deleted', @deleted_sources, lw)
    end
    rows << @ui.kv('Errors', @errors.length, lw) if @errors.any?
    @ui.box(@dry_run ? 'Summary · dry run' : 'Summary', rows)

    if @errors.any?
      @errors.first(10).each { |error| @ui.item(:err, error) }
      @ui.note("…and #{@errors.length - 10} more") if @errors.length > 10
    end

    @ui.blank
    handled = @processed_files + @duplicate_skipped
    if @errors.empty? && handled > 0
      @ui.item(:ok, @ui.colorize(:ok, "#{@dry_run ? 'Dry run' : 'Import'} completed successfully!"))
    elsif handled == 0 && @errors.empty?
      @ui.item(:info, 'No files were processed.')
    else
      @ui.item(:err, @ui.colorize(:err, "#{@dry_run ? 'Dry run' : 'Import'} completed with errors."))
    end
  end
end

# Main execution
if __FILE__ == $0
  options = {}
  ui = UI.new
  option_parser = OptionParser.new do |opts|
    opts.banner = "Usage: ruby gopro_storm [options] [source_path...] [destination_path]"
    opts.separator ""
    opts.separator "Arguments:"
    opts.separator "  source_path      - Path(s) to SD card(s) or directory containing GoPro files"
    opts.separator "                     (if not specified, auto-detects GoPro volumes)"
    opts.separator "  destination_path - Optional: Directory to import files to (defaults to current directory)"
    opts.separator ""
    opts.separator "Options:"

    opts.on("--volumes V1,V2", Array, "Specify volumes to scan (comma-separated)") do |volumes|
      options[:volumes] = volumes
    end

    opts.on("--auto-detect", "Auto-detect GoPro volumes (default when no source_path given)") do
      options[:auto_detect] = true
    end

    opts.on("--dry-run", "Show what would be done without actually copying files") do
      options[:dry_run] = true
    end

    opts.on("--limit N", Integer, "Limit number of files to process in dry-run mode (for testing)") do |n|
      options[:max_files] = n
    end

    opts.on("--since DATE", "Only import files created on or after DATE (YYYY-MM-DD)") do |date_str|
      begin
        options[:since_date] = Date.parse(date_str)
      rescue ArgumentError
        ui.item(:err, "Invalid date format: #{date_str}. Use YYYY-MM-DD.")
        exit 1
      end
    end

    opts.on("--until DATE", "Only import files created on or before DATE (YYYY-MM-DD)") do |date_str|
      begin
        options[:until_date] = Date.parse(date_str)
      rescue ArgumentError
        ui.item(:err, "Invalid date format: #{date_str}. Use YYYY-MM-DD.")
        exit 1
      end
    end

    opts.on("--last-week", "Only import files from the last 7 days") do
      options[:since_date] = Date.today - 7
    end

    opts.on("--check", "Compare SHA-256 checksums between source (camera) and destination copies (no changes made)") do
      options[:check] = true
    end

    opts.on("--clean", "Delete source files that have a verified checksum-matching copy in the destination") do
      options[:clean] = true
    end

    opts.on("--move", "Delete each source file after it is safely copied/verified (move instead of copy)") do
      options[:delete_after] = true
    end

    opts.on("-h", "--help", "Show this help message") do
      puts opts
      exit
    end

    opts.separator ""
    opts.separator "Examples:"
    opts.separator "  ruby gopro_storm                              # Auto-detect GoPro volumes"
    opts.separator "  ruby gopro_storm /Volumes/UNTITLED            # Import from specific volume"
    opts.separator "  ruby gopro_storm --volumes /Volumes/A,/Volumes/B  # Import from multiple volumes"
    opts.separator "  ruby gopro_storm --dry-run                    # Preview auto-detected volumes"
    opts.separator "  ruby gopro_storm --dry-run --limit 5          # Preview with only 5 files (fast testing)"
    opts.separator "  ruby gopro_storm --since=2025-01-01           # Import files from Jan 1, 2025 onward"
    opts.separator "  ruby gopro_storm --until=2025-06-30           # Import files up to Jun 30, 2025"
    opts.separator "  ruby gopro_storm --since=2025-01-01 --until=2025-03-31  # Import a date range"
    opts.separator "  ruby gopro_storm --last-week                  # Import files from the last 7 days"
    opts.separator "  ruby gopro_storm --check --volumes /Volumes/UNTITLED #{DEFAULT_DESTINATION_PATH}  # Verify SHA-256 of camera files against copies"
    opts.separator "  ruby gopro_storm --clean --volumes /Volumes/UNTITLED #{DEFAULT_DESTINATION_PATH}  # Delete camera files already copied (verified by checksum)"
    opts.separator "  ruby gopro_storm --clean --dry-run --volumes /Volumes/UNTITLED #{DEFAULT_DESTINATION_PATH}  # Preview which camera files would be deleted"
    opts.separator "  ruby gopro_storm --move --volumes /Volumes/UNTITLED #{DEFAULT_DESTINATION_PATH}  # Import, then delete each source file once verified"
    opts.separator "  ruby gopro_storm --volumes /Volumes/UNTITLED #{DEFAULT_DESTINATION_PATH}  # Import from volume to destination"
  end

  begin
    option_parser.parse!

    if options[:check] && options[:clean]
      ui.item(:err, 'Error: --check and --clean cannot be used together.')
      exit 1
    end

    if options[:delete_after] && (options[:check] || options[:clean])
      ui.item(:err, 'Error: --move cannot be combined with --check or --clean.')
      exit 1
    end

    # Determine source paths
    source_paths = if options[:volumes]
      # Use explicitly specified volumes
      options[:volumes]
    elsif !ARGV.empty? && !options[:auto_detect]
      # Use command line arguments as source paths
      ARGV.take_while { |arg| !arg.start_with?('--') && arg != Dir.pwd }
    else
      # Auto-detect GoPro volumes
      ui.note('Auto-detecting GoPro volumes…')
      detected = GoProImporter.detect_gopro_volumes
      if detected.empty?
        ui.item(:err, 'No GoPro volumes detected.')
        ui.note('Specify volumes manually using --volumes or provide source paths directly.')
        ui.note('Example: ruby gopro_storm /Volumes/UNTITLED')
        exit 1
      end
      ui.item(:ok, "Found GoPro volumes: #{detected.join(', ')}")
      detected
    end

    # Extract destination path (last argument if it looks like a path and not an option)
    destination_path = DEFAULT_DESTINATION_PATH
    if !ARGV.empty? && ARGV.last != source_paths.last && !ARGV.last.start_with?('--')
      destination_path = ARGV.last
    end

    if source_paths.empty?
      ui.item(:err, 'No source paths specified and auto-detection found no GoPro volumes.')
      puts option_parser
      exit 1
    end

    importer = GoProImporter.new(source_paths, destination_path, options[:dry_run], options[:max_files], options[:since_date], options[:until_date], options[:check], options[:clean], options[:delete_after])
    importer.run
  rescue OptionParser::InvalidOption => e
    ui.item(:err, "Error: #{e.message}")
    puts option_parser
    exit 1
  rescue Interrupt
    # Ctrl+C: print a clean message instead of a noisy backtrace.
    # The extra newline moves us below any in-progress panel.
    puts ""
    ui.item(:warn, ui.colorize(:warn, 'Stopped by the user.'))
    exit 130
  rescue => e
    ui.item(:err, "Error: #{e.message}")
    exit 1
  end
end
